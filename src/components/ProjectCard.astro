---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
}

const { title, description, tags = [], githubUrl, liveUrl, featured = false } = Astro.props;
---

<article class="group relative flex flex-col justify-between p-6 rounded-xl bg-[#12161f]/80 border border-[#242b3b] hover:border-slate-600 transition-all duration-200">
  <div>
    <div class="flex items-center justify-between gap-4 mb-3">
      <h3 class="text-lg font-semibold text-slate-100 group-hover:text-amber-400 transition-colors">
        {title}
      </h3>
      {featured && (
        <span class="text-[11px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800/60">
          Destacado
        </span>
      )}
    </div>

    <p class="text-sm text-slate-400 leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <div>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-6">
        {tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded bg-[#181d28] text-slate-300 border border-[#242b3b]">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-center gap-4 pt-4 border-t border-[#242b3b]/60 text-xs font-medium">
      {liveUrl && (
        <a 
          href={liveUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-amber-400 hover:text-amber-300 transition-colors"
        >
          <span>Visitar sitio</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
      {githubUrl && (
        <a 
          href={githubUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-slate-400 hover:text-slate-200 transition-colors"
        >
          <span>Código fuente</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
