---
const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Proyectos', href: '/#proyectos' },
  { name: 'Sobre mí', href: '/#sobre-mi' },
  { name: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#0a0c10]/80 border-b border-[#242b3b]/60">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="group flex items-center gap-2 text-slate-100 font-semibold tracking-tight text-lg hover:text-amber-400 transition-colors">
      <span class="inline-block w-2.5 h-2.5 rounded-sm bg-amber-400 group-hover:scale-110 transition-transform"></span>
      <span>yeipi<span class="text-amber-400">.dev</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="text-sm text-slate-400 hover:text-slate-100 font-medium transition-colors"
        >
          {link.name}
        </a>
      ))}
      <a 
        href="https://github.com/yeipis" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-sm px-3.5 py-1.5 rounded-md border border-slate-700 hover:border-slate-500 text-slate-200 hover:text-white bg-slate-900/50 hover:bg-slate-800/80 transition-all font-medium"
      >
        GitHub
      </a>
    </nav>

    <!-- Mobile Navigation Menu button -->
    <div class="flex items-center gap-3 md:hidden">
      <a 
        href="https://github.com/yeipis" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-xs px-3 py-1.5 rounded-md border border-slate-700 text-slate-200 bg-slate-900/50 font-medium"
      >
        GitHub
      </a>
    </div>
  </div>
</header>
